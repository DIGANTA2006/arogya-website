# =====================================================
# AROGYA WEBSITE ENVIRONMENT VARIABLES
# Copy this to .env.local for local development.
# Add the real values in Vercel Project Settings → Environment Variables.
# =====================================================

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Auth
AUTH_SECRET=generate_a_32_plus_character_random_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=generate_bcrypt_hash_do_not_use_plain_password

# Cron
CRON_SECRET=generate_a_long_random_cron_secret

# Email / Resend
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Arogya Clinic <onboarding@resend.dev>
APPOINTMENT_EMAIL=clinic@example.com

# Twilio SMS OTP
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Optional
NEXT_PUBLIC_GOOGLE_MAPS_URL=your_google_maps_url
# Rate limiting / Upstash Redis
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Indian OTP provider
FAST2SMS_API_KEY=your_fast2sms_api_key
